{
  "$description": "Tier 2: meaning. Components use only these. Each entry has a light and a dark value.",
  "background": {
    "$value": {
      "light": "{color.white}",
      "dark": "{color.slate.950}"
    },
    "$description": "Page background"
  },
  "foreground": {
    "$value": {
      "light": "{color.slate.950}",
      "dark": "{color.slate.50}"
    },
    "$description": "Default text"
  },
  "surface": {
    "$value": {
      "light": "{color.white}",
      "dark": "{color.slate.900}"
    },
    "$description": "Cards, inputs, popovers, dialogs"
  },
  "muted": {
    "$value": {
      "light": "{color.slate.100}",
      "dark": "{color.slate.800}"
    },
    "$description": "Quiet fills: hover rows, segmented track, avatar"
  },
  "muted-foreground": {
    "$value": {
      "light": "{color.slate.600}",
      "dark": "{color.slate.400}"
    },
    "$description": "Secondary text"
  },
  "subtle-foreground": {
    "$value": {
      "light": "{color.slate.500}",
      "dark": "{color.slate.500}"
    },
    "$description": "Placeholders, icons, hints"
  },
  "border": {
    "$value": {
      "light": "{color.slate.300}",
      "dark": "{color.slate.700}"
