    "$value": {
      "light": "{color.brand.100}",
      "dark": "{color.brand.900}"
    }
  },
  "inverse": {
    "$value": {
      "light": "{color.slate.950}",
      "dark": "{color.slate.50}"
    },
    "$description": "Opposite surface: tooltip, default badge, checked radio"
  },
  "inverse-foreground": {
    "$value": {
      "light": "{color.white}",
      "dark": "{color.slate.950}"
    }
  },
  "destructive": {
    "$value": {
      "light": "{color.red.600}",
      "dark": "{color.red.600}"
    },
