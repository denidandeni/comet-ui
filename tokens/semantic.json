  "primary-hover": {
    "$value": {
      "light": "{color.primary-hover.light}",
      "dark": "{color.primary-hover.dark}"
    }
  },
  "primary-foreground": {
    "$value": {
      "light": "{color.primary-foreground.light}",
      "dark": "{color.primary-foreground.dark}"
    },
    "$description": "Text on primary"
  },
  "brand-subtle": {
    "$value": {
      "light": "{color.brand.50}",
      "dark": "{color.brand.950}"
    },
    "$description": "Tinted brand fill"
