    "$value": {
      "light": "#084e70",
      "dark": "#0e85b8"
    },
    "$description": "Chart series 1-8. Color-blind safe (checked under deuteranopia, protanopia, tritanopia) and each series has its own lightness, so they stay apart in grayscale. 3:1 or better on surface. Fixed across brands."
  },
  "chart-2": {
    "$value": {
      "light": "#c36f4c",
      "dark": "#febaa5"
    }
  },
  "chart-3": {
    "$value": {
      "light": "#037149",
      "dark": "#0db475"
    }
  },
  "chart-4": {
    "$value": {
      "light": "#61188b",
      "dark": "#8a55cd"
    }
  },
  "chart-5": {
    "$value": {
      "light": "#9f9133",
      "dark": "#e5d98a"
    }
  },
  "chart-6": {
    "$value": {
      "light": "#a5263b",
      "dark": "#f05f63"
    }
  },
  "chart-7": {
    "$value": {
      "light": "#048399",
      "dark": "#0ec8ed"
    }
